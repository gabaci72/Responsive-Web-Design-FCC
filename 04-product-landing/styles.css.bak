body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

#header {
    background-color: #f8f9fa;
    padding: 20px;
    text-align: center;
}

#header-img {
    max-width: 150px;
}

#nav-bar {
    position: fixed;
    top: 0;
    width: 100%;
    background-color: #333;
    display: flex;
    justify-content: center;
    padding: 10px 0;
}

.nav-link {
    color: white;
    margin: 0 15px;
    text-decoration: none;
}

.nav-link:hover {
    text-decoration: underline;
}

main {
    padding-top: 60px;
}

section {
    padding: 20px;
    margin: 20px 0;
}

h2 {
    color: #333;
}

@media (max-width: 600px) {
    #nav-bar {
        flex-direction: column;
    }

    .nav-link {
        margin: 5px 0;
    }
}
